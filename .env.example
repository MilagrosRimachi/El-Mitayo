# Copia este archivo como .env.local y llena los datos del proyecto Supabase de EL MITAYO
# (Supabase → Project Settings → API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clave secreta del servidor (service_role / secret). NUNCA se comparte.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Consulta de DNI y RUC (https://decolecta.com/profile). Puede ser el mismo token de la botica.
DECOLECTA_TOKEN=tu-token-de-decolecta

# Llave para cifrar el certificado y la clave SOL (32 bytes en base64). Secreto.
# Se genera con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUNAT_LLAVE=pega-aqui-la-llave-generada
